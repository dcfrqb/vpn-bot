# Telegram Bot Configuration
BOT_TOKEN=your_bot_token_here
ADMINS=123456789,987654321

# Database Configuration
# Для Docker Compose используйте значения по умолчанию или переопределите:
POSTGRES_DB=crs_vpn
POSTGRES_USER=crs_user
POSTGRES_PASSWORD=crs_pass
POSTGRES_PORT=5432

# Или укажите полный URL (для внешней БД):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Redis Configuration (optional)
# Для Docker Compose используется значение по умолчанию
# REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# YooKassa Payment Configuration
YOOKASSA_SHOP_ID=your_shop_id_here
YOOKASSA_API_KEY=your_api_key_here
# Deep Link для возврата после оплаты (замените your_bot_username на имя вашего бота)
YOOKASSA_RETURN_URL=https://t.me/your_bot_username?start=payment_success
YOOKASSA_WEBHOOK_SECRET=your_webhook_secret_here

# Remna API Configuration
REMNA_API_BASE=https://your-remna-api.com
REMNA_API_KEY=your_remna_api_key_here

# Webhook Configuration (optional)
# Если используете webhook вместо polling, укажите URL:
# Telegram Webhook URL (для получения обновлений от Telegram)
TELEGRAM_WEBHOOK_URL=https://bot.crs-projects.com/webhook

# YooKassa Webhook URL (для получения уведомлений о платежах)
YOOKASSA_WEBHOOK_URL=https://pay.crs-projects.com/webhook/yookassa

# Порт для FastAPI webhook сервера (по умолчанию 8001)
WEBHOOK_API_PORT=8001

# Crypto Payment Configuration (optional)
CRYPTO_USDT_TRC20_ADDRESS=your_usdt_trc20_wallet_address_here
CRYPTO_NETWORK=TRC20

# Payment Request HMAC Secret (для подписи заявок на оплату)
# Сгенерируйте: openssl rand -hex 32
PAYREQ_HMAC_SECRET=your_hmac_secret_here
# --- Хотфикс 2.1 ---
# Выключатели промокодов (true/false). Раньше в .env игнорировались.
PROMO_TRIAL_ENABLED=true
PROMO_SOLOKHIN_ENABLED=true
PROMO_ADMIN_ENABLED=true
PROMO_SUN718_ENABLED=true
# Фоновые задачи. Для отладочного бота (ходит в боевую панель) ставьте
# BACKGROUND_TASKS_ENABLED=false, остальные TASK_* выключают задачи по одной.
BACKGROUND_TASKS_ENABLED=true
TASK_RECOVERY_ENABLED=true
TASK_EXPIRY_NOTIFIER_ENABLED=true
TASK_RECONCILER_ENABLED=true
TASK_SUN718_REVERT_ENABLED=true
TASK_BROADCAST_RESUME_ENABLED=true
# Откуда webhook-api принимает X-Real-IP (nginx на хосте -> docker-шлюз).
# docker-gateway = шлюз docker-сети, определяется автоматически.
# WEBHOOK_TRUSTED_PROXIES=127.0.0.1/32,::1/128,docker-gateway
